# ── App ──────────────────────────────────────────────
APP_NAME=AI Data Analyst
APP_VERSION=0.1.0
DEBUG=false

# ── Server ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]

# ── Database (MySQL) ─────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=t2s_analysis

# ── LLM ──────────────────────────────────────────────
# Supported: DeepSeek, OpenAI, or any OpenAI-compatible API
# Get your API key at https://platform.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com

# ── SQL Executor ─────────────────────────────────────
SQL_TIMEOUT=10
SQL_MAX_ROWS=500

# ── Auth ────────────────────────────────────────────
# Change this to a random string in production!
JWT_SECRET_KEY=change-me-to-a-random-string

# ── Redis（SQL 缓存）────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── LangSmith Tracing（可选）─────────────────────────
# 填写 API Key 即启用，留空则不接入
# 获取 Key: https://smith.langchain.com/settings
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=t2s-analysis
