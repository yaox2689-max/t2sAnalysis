# t2sAnalysis 环境变量配置
# 复制此文件为 .env 并填入你的配置：
#   cp .env.example .env
#
# Docker 部署：此文件放在项目根目录，docker-compose 自动读取
# 本地开发：复制到 backend/ 目录
#   cp .env.example backend/.env

# ── App ──────────────────────────────────────────────
APP_NAME=AI Data Analyst
APP_VERSION=0.1.0
DEBUG=false

# ── Server ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost"]

# ── Database (MySQL) ─────────────────────────────────
# Docker 部署时 DB_HOST=mysql，本地开发时 DB_HOST=localhost
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=t2s_analysis

# ── Redis（SQL 查询缓存）─────────────────────────────
# Docker 部署时 REDIS_HOST=redis，本地开发时 REDIS_HOST=localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ── LLM (必填) ──────────────────────────────────────
# 支持 DeepSeek、OpenAI 或任何 OpenAI 兼容 API
# 获取 Key: https://platform.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com

# ── SQL 执行 ─────────────────────────────────────────
SQL_TIMEOUT=10
SQL_MAX_ROWS=500
DEFAULT_MAX_RETRIES=3

# ── Auth（JWT 认证）──────────────────────────────────
# 必填！请设置为一个安全的随机字符串（至少 32 字符）
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# ── Redis 安全 ────────────────────────────────────────
REDIS_CONNECT_TIMEOUT=3
CACHE_TTL_SECONDS=3600

# ── HTTP 代理（可选）──────────────────────────────────
# 如果你的网络需要代理访问 LLM API，请取消注释并填入代理地址
# HTTP_PROXY=
# HTTPS_PROXY=

# ── LangSmith 链路追踪（可选）────────────────────────
# 填写 API Key 即启用，留空则不接入
# 获取 Key: https://smith.langchain.com/settings
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=t2s-analysis
